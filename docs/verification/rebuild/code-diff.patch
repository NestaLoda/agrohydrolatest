+async function request<T>(path: string, options?: RequestInit): Promise<T> {
+  const response = await fetch(`/api${path}`, { ...options, headers: { ...(options?.body instanceof FormData ? {} : { 'Content-Type': 'application/json' }), ...options?.headers } })
