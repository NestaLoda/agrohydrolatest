{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/**,tests/**,docs/**,presentation/**,hardware/**,output/**,tmp/**,.venv/**,.pytest_cache/**,**/__pycache__/**,data/north/derived_plans/**,data/north/frozen_runs/**,data/north/validation_records/**,data/pwn/**,data/metadata/*.sqlite*}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index"}
  ]
}
